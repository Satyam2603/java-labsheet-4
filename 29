class Employee {
    String name;
    double salary;

    static String organization = "ABC Company";

    Employee(String n, double s) {
        name = n;
        salary = s;
    }

    void compareSalary(Employee e) {
        double salaryDifference;

        System.out.println("Organization: " + organization);

        if (salary > e.salary) {
            salaryDifference = salary - e.salary;
            System.out.println(name + " has a higher salary.");
        } else if (salary < e.salary) {
            salaryDifference = e.salary - salary;
            System.out.println(e.name + " has a higher salary.");
        } else {
            salaryDifference = 0;
            System.out.println("Both employees have equal salaries.");
        }

        System.out.println("Salary Difference: " + salaryDifference);
    }

    public static void main(String[] args) {
        Employee e1 = new Employee("Rahul", 30000);
        Employee e2 = new Employee("Amit", 25000);

        e1.compareSalary(e2);
    }
}
