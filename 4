class Employee {
    int empId;
    double salary;

    static String companyName = "TCS";

    void setDetails() {
        int id = 101;
        double sal = 35000;

        empId = id;
        salary = sal;
    }

    void display() {
        System.out.println("Employee ID: " + empId);
        System.out.println("Salary: " + salary);
        System.out.println("Company: " + companyName);
    }

    public static void main(String[] args) {
        Employee e = new Employee();
        e.setDetails();
        e.display();
    }
}
