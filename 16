class Triangle {
    int a, b, c;

    static String type;

    void checkTriangle() {
        int x = 5;
        int y = 5;
        int z = 5;

        a = x;
        b = y;
        c = z;

        if (a + b > c && a + c > b && b + c > a) {

            if (a == b && b == c) {
                type = "Equilateral";
            } else if (a == b || b == c || a == c) {
                type = "Isosceles";
            } else {
                type = "Scalene";
            }

            System.out.println("Valid Triangle");
            System.out.println("Triangle Type: " + type);

        } else {
            System.out.println("Invalid Triangle");
        }
    }

    public static void main(String[] args) {
        Triangle t = new Triangle();
        t.checkTriangle();
    }
}
