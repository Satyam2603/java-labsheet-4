class Laptop {
    String brand;
    int RAM;

    static String os = "Windows";

    void setDetails() {
        String b = "Lenovo";
        int r = 16;

        brand = b;
        RAM = r;
    }

    void display() {
        System.out.println("Brand: " + brand);
        System.out.println("RAM: " + RAM + " GB");
        System.out.println("Operating System: " + os);
    }

    public static void main(String[] args) {
        Laptop l = new Laptop();
        l.setDetails();
        l.display();
    }
}
