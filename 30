class Library {
    int booksAvailable;

    static String libraryName = "Central Library";

    Library(int books) {
        booksAvailable = books;
    }

    void issueBooks(int quantity) {
        int remainingBooks;

        if (quantity > 0 && quantity <= booksAvailable) {
            remainingBooks = booksAvailable - quantity;
            booksAvailable = remainingBooks;

            System.out.println(quantity + " books issued successfully.");
        } else {
            System.out.println("Books are not available.");
        }

        System.out.println("Available Books: " + booksAvailable);
    }

    void returnBooks(int quantity) {
        int updatedBooks;

        if (quantity > 0) {
            updatedBooks = booksAvailable + quantity;
            booksAvailable = updatedBooks;

            System.out.println(quantity + " books returned successfully.");
        } else {
            System.out.println("Invalid return quantity.");
        }

        System.out.println("Available Books: " + booksAvailable);
    }

    public static void main(String[] args) {
        Library l = new Library(50);

        System.out.println("Library Name: " + libraryName);

        l.issueBooks(5);
        l.returnBooks(2);
    }
}
